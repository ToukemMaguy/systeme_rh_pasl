# Copier ce fichier en « .env » puis remplir les valeurs. Ne JAMAIS versionner le fichier .env.

# Base MySQL : utiliser un compte dédié, pas « root » (voir README.md)
DATABASE_URL=mysql+pymysql://pasl_rh:MOT_DE_PASSE_ICI@localhost:3306/systeme_rh

# Clé de signature des sessions (32 caractères minimum). Pour en générer une :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Envoi des mails (Mailtrap pour les tests)
SMTP_SERVER=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=PASL-RH
SMTP_FROM_EMAIL=

# Adresse de l'application, utilisée dans les liens des mails.
# EN PRODUCTION : l'adresse du serveur vue depuis les postes, ex. http://NOM-DU-SERVEUR:8000
APP_URL=http://127.0.0.1:8000

# Pause entre deux mails, en secondes (limite d'envoi du fournisseur)
SMTP_PAUSE=1.5

# Sauvegardes quotidiennes (app/scripts/sauvegarder.py)
# Programme mysqldump de XAMPP :
MYSQLDUMP=C:\xampp\mysql\bin\mysqldump.exe
# Dossier des sauvegardes : de préférence un AUTRE disque ou un partage réseau (ex. D:\Sauvegardes\PASL-RH)
SAUVEGARDE_DOSSIER=sauvegardes
# Nombre de jours de sauvegardes conservés
SAUVEGARDE_JOURS=30
